<mujoco model="Skydio X2 scene">

  <include file="x2.xml"/>

  <option 
    gravity="0 0 -9.81" 
    density="1.225"
    viscosity="1.8e-5"
    timestep="0.01"
    iterations="50"
    tolerance="1e-10"
    solver="Newton"/>

  <size memory="50M"/>
  <statistic center="0 0 0.1" extent="0.6" meansize=".05"/>

  <!-- <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-20" elevation="-20" ellipsoidinertia="true"/>
  </visual> -->

  <asset>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1"/>
    <light pos="0.3 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" pos="0 0 -0.1" size="0 0 0.05" type="plane" material="groundplane"/>
    
    <body name="object" pos="0.3 0 0.1">
      <geom type="sphere" size="0.03" rgba="0.5 0.7 0.5 1"/>  <!-- Simple sphere with basic physics -->
    </body>
    <!-- <body name="object" pos="0.3 0 0.1">
      <freejoint/> -- this is the error
      <geom type="ellipsoid" size="0.03 0.04 0.02" rgba="0.5 0.7 0.5 1" condim="6" priority="1"
          friction="0.5 0.01 0.003"/>
    </body> -->
  </worldbody>

</mujoco>